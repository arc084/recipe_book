<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon, used from Android 8 onwards.

     Two layers rather than the finished tile, because the launcher applies its
     own mask — circle, squircle, teardrop — and needs to crop the ground
     itself. The foreground is a 108dp square with the 512 tile's artwork drawn
     into its middle 72dp — the part a launcher actually shows — so the pot
     sits in the tile at the same size as on Windows.

     The finished tile still ships as mipmap/ic_launcher.png for anything older
     than this. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
