<?xml version="1.0" encoding="utf-8"?>
<!--
  Sync talks plain HTTP to another device on the same network. A self-signed
  certificate with no authority to check it against would prove nothing, so the
  requests are signed with the key the two devices agreed at pairing instead.

  This file used to try to permit cleartext "only to private ranges" by listing
  CIDR blocks in <domain> elements. That never worked: <domain> takes a
  hostname or a literal IP and the schema has no subnet syntax at all, so only
  the localhost entry ever matched and every sync to a real LAN address was
  blocked outright.

  The restriction has moved to where it can actually be expressed and tested:
  isPrivateAddress() in lib/sync/protocol.dart, enforced by SyncClient before
  it dials anything and by the recipe importer, which requires HTTPS for any
  host that is not on the local network. Dart can check an address properly;
  this file cannot.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
